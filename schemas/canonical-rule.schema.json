{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontier-engineer.local/schemas/canonical-rule.json",
  "title": "Platform-independent canonical rule specification frontmatter",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "triggerType",
    "description",
    "priority",
    "enforcementLevel",
    "platformConfig"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "engineering",
        "frontend",
        "backend",
        "database",
        "security",
        "testing",
        "performance"
      ]
    },
    "triggerType": {
      "type": "string",
      "enum": ["always_on", "glob", "model_decision"]
    },
    "globs": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "enforcementLevel": {
      "type": "string",
      "enum": ["mandatory", "advisory"]
    },
    "platformConfig": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "triggerType": { "const": "glob" } },
        "required": ["triggerType"]
      },
      "then": {
        "required": ["globs"]
      }
    }
  ]
}
