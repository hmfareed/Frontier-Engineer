{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontier-engineer.local/schemas/evaluation-scenarios.json",
  "title": "Frontier Engineer agent evaluation scenarios",
  "type": "object",
  "required": ["version", "status", "agents", "rubric"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["defined", "executing", "measured"] },
    "note": { "type": "string" },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": ["id", "title", "prompt", "expectedBehaviors"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
            "title": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "expectedBehaviors": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["dimension", "question"],
        "additionalProperties": false,
        "properties": {
          "dimension": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    }
  }
}
