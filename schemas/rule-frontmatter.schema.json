{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontier-engineer.local/schemas/rule-frontmatter.json",
  "title": "Antigravity named rule frontmatter",
  "type": "object",
  "required": ["trigger"],
  "additionalProperties": false,
  "properties": {
    "trigger": {
      "type": "string",
      "enum": ["always_on", "model_decision", "glob", "manual"]
    },
    "description": { "type": "string" },
    "globs": { "type": "string" },
    "glob": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trigger": { "const": "model_decision" } },
        "required": ["trigger"]
      },
      "then": { "required": ["description"] }
    },
    {
      "if": {
        "properties": { "trigger": { "const": "glob" } },
        "required": ["trigger"]
      },
      "then": {
        "anyOf": [{ "required": ["globs"] }, { "required": ["glob"] }]
      }
    }
  ]
}
