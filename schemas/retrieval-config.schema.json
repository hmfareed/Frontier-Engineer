{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "frontier-engineer/retrieval-config.schema.json",
  "title": "Frontier Engineer Retrieval Workspace Configuration",
  "description": "Optional workspace-level overrides (.frontier/retrieval.config.json) bounded by system safety ceilings.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "defaults": {
      "$ref": "#/definitions/limitOverrides"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontier-engineer": { "$ref": "#/definitions/agentOverride" },
        "architect": { "$ref": "#/definitions/agentOverride" },
        "implementation-engineer": { "$ref": "#/definitions/agentOverride" },
        "security-auditor": { "$ref": "#/definitions/agentOverride" },
        "qa-engineer": { "$ref": "#/definitions/agentOverride" },
        "design-engineer": { "$ref": "#/definitions/agentOverride" }
      }
    }
  },
  "definitions": {
    "limitOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxTotalChars": { "type": "integer", "minimum": 1024, "maximum": 128000 },
        "maxTokens": { "type": "integer", "minimum": 256, "maximum": 32000 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxSnippetLines": { "type": "integer", "minimum": 5, "maximum": 80 }
      }
    },
    "agentOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeSnippets": { "type": "boolean" },
        "includeHistoricalMemories": { "type": "boolean" },
        "limits": { "$ref": "#/definitions/limitOverrides" },
        "priorityDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "overview",
              "components",
              "files",
              "symbols",
              "dependencies",
              "tests",
              "decisions",
              "memories",
              "evolution",
              "snippets"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
