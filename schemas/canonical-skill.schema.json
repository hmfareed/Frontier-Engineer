{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontier-engineer.local/schemas/canonical-skill.json",
  "title": "Platform-independent canonical skill specification frontmatter",
  "type": "object",
  "required": [
    "id",
    "name",
    "title",
    "version",
    "summary",
    "description",
    "requiredCapabilities",
    "primaryAgents",
    "activationTriggers",
    "nonActivationGuidelines",
    "platformConfig"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 1024
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "primaryAgents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "frontier-engineer",
          "architect",
          "implementation-engineer",
          "security-auditor",
          "qa-engineer",
          "design-engineer"
        ]
      }
    },
    "activationTriggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonActivationGuidelines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "platformConfig": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
