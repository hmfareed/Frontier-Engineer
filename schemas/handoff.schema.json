{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frontier-engineer.local/schemas/handoff.json",
  "title": "Frontier Engineer handoff and specialist response contract",
  "oneOf": [{ "$ref": "#/definitions/handoff" }, { "$ref": "#/definitions/response" }],
  "definitions": {
    "handoff": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "taskId",
        "requestSummary",
        "objective",
        "repositoryContext",
        "scope",
        "constraints",
        "relevantFiles",
        "expectedDeliverables",
        "acceptanceCriteria",
        "risks",
        "requiredVerification"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "frontier-engineer/handoff" },
        "version": { "const": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "requestSummary": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "repositoryContext": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "relevantFiles": { "type": "array", "items": { "type": "string" } },
        "expectedDeliverables": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "requiredVerification": { "type": "array", "items": { "type": "string" } },
        "fromAgent": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toAgent": { "type": "string", "minLength": 1, "maxLength": 128 },
        "degradedIndexingMode": { "type": "string", "enum": ["DEGRADED_UNINDEXED"] },
        "degradedReason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retrievalContext": { "$ref": "#/definitions/retrievalContextAttachment" }
      }
    },
    "retrievalContextAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "version",
        "retrievalId",
        "repositoryIdentity",
        "scanId",
        "snapshotStatus",
        "freshnessStatus",
        "isStale",
        "taskType",
        "confidenceSummary",
        "highlights",
        "warnings",
        "budget"
      ],
      "properties": {
        "contract": { "const": "frontier-engineer/retrieval-attachment" },
        "version": { "const": 1 },
        "retrievalId": { "type": "string", "minLength": 8 },
        "repositoryIdentity": { "type": "string", "minLength": 1 },
        "scanId": { "type": "integer", "minimum": 1 },
        "snapshotStatus": { "type": "string", "minLength": 1 },
        "freshnessStatus": { "type": "string", "minLength": 1 },
        "isStale": { "type": "boolean" },
        "taskType": { "type": "string", "minLength": 1 },
        "confidenceSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmedCount",
            "inferredCount",
            "candidateCount",
            "unresolvedCount",
            "isMixedConfidence"
          ],
          "properties": {
            "confirmedCount": { "type": "integer", "minimum": 0 },
            "inferredCount": { "type": "integer", "minimum": 0 },
            "candidateCount": { "type": "integer", "minimum": 0 },
            "unresolvedCount": { "type": "integer", "minimum": 0 },
            "isMixedConfidence": { "type": "boolean" }
          }
        },
        "highlights": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "idOrPath", "summary", "confidenceTier"],
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "overview",
                  "components",
                  "files",
                  "symbols",
                  "dependencies",
                  "tests",
                  "decisions",
                  "memories",
                  "evolution",
                  "snippets"
                ]
              },
              "idOrPath": { "type": "string", "minLength": 1, "maxLength": 512 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "confidenceTier": {
                "type": "string",
                "enum": ["CONFIRMED", "INFERRED", "CANDIDATE", "UNRESOLVED"]
              },
              "evidenceFile": { "type": "string", "minLength": 1, "maxLength": 512 },
              "untrustedRepositoryContent": { "type": "boolean" },
              "evidenceVerificationStatus": {
                "type": "string",
                "enum": ["VERIFIED", "UNVERIFIED", "STALE", "DISPUTED", "CONTRADICTED", "MISSING"]
              },
              "lineRange": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 },
                "minItems": 2,
                "maxItems": 2
              },
              "symbolIdentity": { "type": "string", "minLength": 1, "maxLength": 512 },
              "confidence": {
                "type": "string",
                "enum": ["CONFIRMED", "INFERRED", "CANDIDATE", "UNRESOLVED"]
              },
              "limitations": {
                "type": "array",
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["includedCount", "truncatedCount", "estimatedTokens"],
          "properties": {
            "includedCount": { "type": "integer", "minimum": 0 },
            "truncatedCount": { "type": "integer", "minimum": 0 },
            "estimatedTokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "contract",
        "version",
        "taskId",
        "findings",
        "workCompleted",
        "filesAffected",
        "decisions",
        "risks",
        "verification",
        "unresolvedQuestions",
        "handoffStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "frontier-engineer/response" },
        "version": { "const": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "findings": { "type": "array", "items": { "type": "string" } },
        "workCompleted": { "type": "array", "items": { "type": "string" } },
        "filesAffected": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "verification": {
          "type": "object",
          "required": ["commands", "outcomes", "testStates"],
          "additionalProperties": false,
          "properties": {
            "commands": { "type": "array", "items": { "type": "string" } },
            "outcomes": { "type": "array", "items": { "type": "string" } },
            "testStates": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "not written",
                  "not executed",
                  "passed",
                  "failed",
                  "blocked",
                  "not applicable"
                ]
              }
            }
          }
        },
        "unresolvedQuestions": { "type": "array", "items": { "type": "string" } },
        "handoffStatus": { "type": "string", "enum": ["complete", "partial", "blocked"] }
      }
    }
  }
}
