{
  "globs": ["**/*.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD029": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
  },
  "ignores": [
    "node_modules/**",
    ".workbuddy-ai/**",
    "frontier-engineer-docs/**",
    "tests/fixtures/**",
    "CHANGELOG.md",
  ],
}
