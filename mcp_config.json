{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:v2.1.0",
        "--read-only",
        "--toolsets=context,issues,pull_requests,repos"
      ],
      "disabled": true
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.6.0"
      ],
      "disabled": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated"
      ],
      "disabled": true
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@0.49.0"
      ],
      "disabled": true
    },
    "database": {
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/postgres-mcp@0.3.0",
        "run"
      ],
      "disabled": true
    }
  }
}
